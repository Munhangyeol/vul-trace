# Local development only. Copy to .env and adjust. Never commit real credentials.
POSTGRES_USER=vulntrace
POSTGRES_PASSWORD=vulntrace
POSTGRES_DB=vulntrace
DATABASE_URL=postgresql://vulntrace:vulntrace@localhost:5432/vulntrace?schema=public

# Read by the API server (apps/api) and the web dev proxy (apps/web). A value set in the shell wins.
API_HOST=127.0.0.1
API_PORT=3000

# Optional: restricts registered project paths to this directory (CLAUDE.md §4.2).
# VULNTRACE_SCAN_ROOT=/path/to/allowed/projects
